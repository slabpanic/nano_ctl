[Unit]
Description=nano ctl service for %i
After=network.target

[Service]
Slice=epc-workload.slice
EnvironmentFile=/etc/default/nano_ctl
Environment=PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c 'exec "$$NANO_CTL_ROOT/scripts/start.sh"'
Restart=always
User=%i
Group=%i
WorkingDirectory=~
CPUAffinity=2
AmbientCapabilities=CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_RAWIO
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
